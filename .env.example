# Comma separated Ollama servers; loopback defaults. Restart after editing.
GERALD_OLLAMA_URLS=http://127.0.0.1:11434
# Default locally installed model; :cloud models are blocked in local mode.
GERALD_LOCAL_MODEL=ornith-1.5:9b
# Optional model override for your signed-in Codex CLI cloud provider.
GERALD_CODEX_MODEL=
# Tested tool-capable model for Codex --oss; independent from the HTTP worker default.
GERALD_CODEX_LOCAL_MODEL=qwen2.5-coder:14b
# Optional Anthropic cloud provider. Never put keys in the browser.
ANTHROPIC_API_KEY=
GERALD_ANTHROPIC_MODEL=claude-sonnet-4-5
# Backend port. The compiled frontend is served from this same origin.
GERALD_PORT=8765
# Upper bound on each generation and queue wait.
GERALD_TASK_TIMEOUT=180
